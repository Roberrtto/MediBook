# ── Database (PostgreSQL) ─────────────────────────────────────────────────────
# Local:   postgresql://postgres:password@localhost:5432/medibook
# Railway: get from Railway dashboard
# Neon:    get from Neon dashboard (free tier available)
DATABASE_URL="postgresql://postgres:password@localhost:5432/medibook"

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="replace-this-with-a-long-random-string"
JWT_EXPIRES="7d"

# ── Server ────────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# ── Twilio (FR-10 SMS) ─────────────────────────────────────────────────────────
# Leave blank during development — the server stubs SMS to console.log
# Sign up at https://twilio.com for free trial credits.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ── SendGrid (FR-10 Email) ────────────────────────────────────────────────────
# Leave blank during development — the server stubs email to console.log
# Sign up at https://sendgrid.com for free tier.
SENDGRID_API_KEY=
FROM_EMAIL=noreply@medibook.clinic
