# Copy this file to .env and fill in real values. Never commit .env itself.

PORT=4000
NODE_ENV=development

# Local dev (matches docker-compose.yml). If you're running Postgres yourself,
# point this at your own instance instead.
DATABASE_URL=postgresql://medibook:medibook@localhost:5432/medibook

JWT_SECRET=replace-with-a-long-random-string

# console = logs to terminal (default, no API keys needed)
# twilio  = sends real SMS/email, needs the keys below
NOTIFICATION_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
